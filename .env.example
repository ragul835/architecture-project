# Public canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Zoho SMTP delivery. Store real values in the deployment secret manager.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ragulsiva@zohomail.in
SMTP_PASSWORD=your-zoho-app-password
# Optional recipient; defaults to SMTP_USER.
SMTP_TO=ragulsiva@zohomail.in
