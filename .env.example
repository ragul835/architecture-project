# Public canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Zoho SMTP delivery. Store real values in the deployment secret manager.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=inquiries@example.com
SMTP_PASSWORD=your-zoho-app-password
# Optional recipient; defaults to SMTP_USER.
SMTP_TO=inquiries@example.com

# Set to true only for local/API acceptance testing. No email is sent.
CONTACT_DRY_RUN=false
